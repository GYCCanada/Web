{
  "name": "gycc",
  "version": "1.0.0",
  "description": "GYC Canada conference website",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "bun --bun react-router build",
    "dev": "bun --hot ./server.ts",
    "lint": "oxlint",
    "migrate:legacy-forms": "bun scripts/migrate-legacy-forms.ts",
    "migrate:form-notifications": "bun scripts/migrate-form-notification-projections.ts",
    "start": "NODE_ENV=production bun ./server.ts",
    "typecheck": "react-router typegen && tsgo --noEmit",
    "test": "bun test",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@conform-to/dom": "^1.19.4",
    "@conform-to/react": "^1.19.4",
    "@distilled.cloud/stripe": "0.29.0",
    "@effect/platform-bun": "4.0.0-beta.98",
    "@effect/sql-pg": "4.0.0-beta.98",
    "@epic-web/client-hints": "^1.3.9",
    "@react-router/node": "^8.2.0",
    "@sendgrid/client": "^8.1.6",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "dedent": "^1.7.2",
    "effect": "4.0.0-beta.98",
    "effect-encore": "0.14.0",
    "framer-motion": "^12.42.2",
    "isbot": "^5.2.1",
    "lucide-react": "1.24.0",
    "nanoid": "^6.0.0",
    "nodemailer": "^9.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0",
    "remix-utils": "^10.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tiny-invariant": "^1.3.3",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@effect/sql-pglite": "4.0.0-beta.98",
    "@effect/tsgo": "0.23.0",
    "@react-router/dev": "^8.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.3.14",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "effect-bun-test": "^0.3.0",
    "oxlint": "^1.74.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.1.5"
  },
  "overrides": {
    "effect": "4.0.0-beta.98"
  }
}
